# Merchant Liquidity Engine — Environment Configuration

# Application
PROJECT_NAME="Merchant Liquidity Engine"
ENVIRONMENT="sandbox"
DEBUG=True

# Database
DATABASE_URL="sqlite:///./merchant_liquidity.db"

# LLM Agent Provider (Optional — Deterministic Fallback used if omitted)
GEMINI_API_KEY=""

# Razorpay Test Mode Credentials
# Obtain from: https://dashboard.razorpay.com/app/keys (Select 'Test Mode')
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_test_secret_key_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"
RAZORPAY_TEST_MODE=True
