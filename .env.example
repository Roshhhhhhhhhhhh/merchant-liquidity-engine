# Environment Configuration Example for Merchant Liquidity Engine

# Environment
ENVIRONMENT=sandbox
DEBUG=True

# Backend
API_PORT=8000
DATABASE_URL=sqlite:///./merchant_liquidity.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/merchant_liquidity

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Razorpay Test Mode Integration (MSME Sandbox Context)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_TEST_MODE=True
