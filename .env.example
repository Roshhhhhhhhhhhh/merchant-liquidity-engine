# Environment Configuration Example for Merchant Liquidity Engine

# Environment
ENVIRONMENT=sandbox
DEBUG=True

# Backend
API_PORT=8000
DATABASE_URL=sqlite:///./merchant_liquidity.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/merchant_liquidity

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Razorpay Integration (Deferred to Phase 3)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
